# Servicio del dashboard. Copiar a /etc/systemd/system/froy-dashboard.service
[Unit]
Description=Froy - Dashboard de administración
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/froy/src
EnvironmentFile=/opt/froy/.env
# Gunicorn 25 trae un 'control socket' encendido por defecto y lo quiere crear en
# $HOME/.gunicorn/ ; como el servicio corre con User=www-data, ese HOME es /var/www y
# no hay permiso de escritura -> 'Control server error: Permission denied'. Aquí nadie
# usa `gunicornc`, así que se apaga en vez de abrirle un directorio.
ExecStart=/opt/froy/.venv/bin/gunicorn --no-control-socket --workers 2 --threads 4 --timeout 300 --bind 127.0.0.1:8080 dashboard:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
